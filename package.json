  "license": "CC BY-NC-SA 4.0",
  "dependencies": {
    "axios": "^1.7.2",
    "bcrypt": "^6.0.0",
    "body-parser": "^1.20.3",
    "connect-sqlite3": "^0.9.16",
    "diskusage": "^1.2.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-session": "^1.18.2",
    "fuse.js": "^7.1.0",
    "multer": "^2.0.2",
    "node-schedule": "^2.1.1",
    "sqlite3": "^5.1.7",
    "systeminformation": "^5.27.11",
    "web-push": "^3.6.7",
    "xml-js": "^1.6.11"
  },
  "devDependencies": {
    "jsdom": "^29.1.0",
    "nock": "^14.0.13",
    "supertest": "^7.2.2",
    "tmp": "^0.2.5",
    "vitest": "^0.34.6"
  }
