{
  "name": "viniplay",
  "version": "1.0.1",
  "description": "A simple IPTV player with server-side storage and user authentication.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:syntax": "node --check server.js && find public/js -name '*.js' -print0 | xargs -0 -n1 node --check",
    "check:diff": "git diff --check"
  },
